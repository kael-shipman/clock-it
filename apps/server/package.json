{
  "name": "@clock-it/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs server",
    "bundle": "pnpm run build && node ./scripts/bundle.mjs",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});\"",
    "package": "pnpm run build && node ./scripts/package.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@clock-it/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@wymp/config-simple": "^1.0.0",
    "@wymp/weenie-base": "^1.3.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "es-toolkit": "^1.45.1",
    "kysely": "^0.28.16"
  }
}
