{
  "name": "clockit",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "bundle:server": "pnpm --filter @clock-it/server bundle",
    "clean": "pnpm -r clean && node -e \"const fs=require('node:fs');fs.rmSync('artifacts',{recursive:true,force:true});\"",
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:client": "node ./scripts/dev-client.mjs",
    "dev:server": "tsx watch apps/server/src/index.ts run --config ./.dev/server.json",
    "package": "pnpm run package:server && pnpm run package:client",
    "package:client": "pnpm --filter @clock-it/client package",
    "package:server": "pnpm --filter @clock-it/server package",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
